{
  "name": "tracktist",
  "version": "0.1.0",
  "private": true,
  "description": "Tracktist — track your favourite artists, your personal live-music radar.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @tracktist/web dev",
    "worker": "pnpm --filter @tracktist/worker dev",
    "test": "pnpm -r test",
    "test:core": "pnpm --filter @tracktist/core test",
    "spike0": "pnpm --filter @tracktist/core spike0",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @tracktist/web prisma migrate dev",
    "db:generate": "pnpm --filter @tracktist/web prisma generate",
    "db:seed": "pnpm --filter @tracktist/web db:seed"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
