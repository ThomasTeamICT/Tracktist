    "clsx": "2.1.1",
    "globe.gl": "^2.46.1",
    "lucide-react": "0.469.0",
    "next": "15.1.6",
    "next-auth": "5.0.0-beta.25",
    "nodemailer": "6.9.16",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "server-only": "0.0.1",
    "tailwind-merge": "2.6.0",
    "web-push": "3.6.7",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "22.7.5",
    "@types/nodemailer": "6.4.17",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "@types/web-push": "3.6.4",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
