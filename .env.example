# ──────────────────────────────────────────────────────────────────────────
# Tracktist — omgevingsvariabelen (voorbeeld)
#
# Kopieer dit bestand naar `.env` en vul de echte waarden in.
# Commit NOOIT je echte `.env` — zet `.env` in `.gitignore`.
# Alle sleutels worden uitsluitend SERVER-SIDE gebruikt (nooit in frontendcode).
# Legenda:  [MVP] nu nodig   ·   [OPTIONEEL] handig maar niet vereist   ·   [V2] later
# ──────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_BASE_URL=http://localhost:3000           # [MVP] publieke basis-URL van de app

# ── Database & cache ──────────────────────────────────────────────────────
# [MVP] PostgreSQL met PostGIS-extensie (voor geo-/afstandsqueries)
DATABASE_URL=postgresql://user:password@localhost:5432/tracktist
# [MVP] Redis voor caching + job queue (BullMQ)
REDIS_URL=redis://localhost:6379

# ── Authenticatie (Auth.js / NextAuth) ────────────────────────────────────
AUTH_SECRET=                                  # [MVP] genereer met: openssl rand -base64 32
# E-mail magic link [MVP]
EMAIL_SERVER=smtp://user:password@smtp.host:587
EMAIL_FROM=Tracktist <no-reply@tracktist.app>
# Google login [MVP] — console.cloud.google.com → OAuth client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple login [OPTIONEEL] — developer.apple.com → Sign in with Apple
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ── Eventbronnen (concertdata) ────────────────────────────────────────────
# [MVP] Ticketmaster Discovery API — developer.ticketmaster.com (gratis, ~5000 calls/dag)
TICKETMASTER_API_KEY=
# [V2] Ticketmaster affiliate publisher-ID (Impact of Sovrn) — voor ticketlink-commissie
TICKETMASTER_AFFILIATE_PUBLISHER_ID=
# [MVP] Bandsintown Public API — zelfgekozen app_id (bv. je domein); registreer voor productie
BANDSINTOWN_APP_ID=
# [OPTIONEEL] Setlist.fm (context/historiek) — api.setlist.fm
SETLISTFM_API_KEY=

# ── Artiest-metadata & import ─────────────────────────────────────────────
# [MVP] MusicBrainz vereist een herkenbare User-Agent met contact-info (geen sleutel)
MUSICBRAINZ_USER_AGENT=Tracktist/1.0 ( contact@tracktist.app )
# [OPTIONEEL] Last.fm import — last.fm/api
LASTFM_API_KEY=
LASTFM_SHARED_SECRET=
# [OPTIONEEL, achter haalbaarheidscheck] Spotify — developer.spotify.com
# Let op: nieuwe apps zitten achter zware poorten (Premium-dev, max 5 testers,
# extended access vereist bedrijf + 250k MAU). Bouw de app volwaardig zonder Spotify.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ── Geocoding (alleen fallback voor handmatige/festival-venues) ───────────
# [OPTIONEEL] TM en Bandsintown leveren meestal al coördinaten; dit is enkel een vangnet
GEOCODER_API_KEY=

# ── Notificaties ──────────────────────────────────────────────────────────
# [MVP] Web Push (VAPID) — genereer met: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@tracktist.app
# [V2] Native push (mobiel)
FCM_SERVER_KEY=                               # Android (Firebase Cloud Messaging)
APNS_KEY_ID=                                  # iOS (Apple Push Notification service)
APNS_TEAM_ID=
APNS_PRIVATE_KEY=

# ── Observability ─────────────────────────────────────────────────────────
SENTRY_DSN=                                   # [OPTIONEEL] foutopvolging
